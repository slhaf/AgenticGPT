{
  "displayName": "agentic-gpt-linux",
  "mode": "standalone",
  "profile": "normal",
  "toolsets": {
    "enabled": [
      "agent",
      "file",
      "mcp",
      "process",
      "skills",
      "tmux",
      "browser"
    ]
  },
  "events": {
    "lowTtlSeconds": 86400,
    "internalOverrides": {}
  },
  "tunnel": {
    "tunnelId": "tunnel_replace-me",
    "apiKey": "file:/home/your-user/.agentic_gpt/secrets/tunnel-api-key"
  },
  "httpMcp": {
    "enabled": false,
    "host": "127.0.0.1",
    "port": 8765,
    "publicUrl": null,
    "bearerToken": "",
    "allowHosts": [
      "localhost",
      "127.0.0.1",
      "::1"
    ]
  },
  "hub": {
    "url": "https://agentic-gpt.example.com",
    "transport": "websocket",
    "agentSecret": "change-me-before-use"
  },
  "workspaceRoot": "/home/your-user/.agentic_gpt/workspace",
  "browser": {},
  "room": {
    "repositoryRoot": null,
    "timezone": "Asia/Shanghai",
    "diaryDayBoundaryHour": 5,
    "maintenance": {
      "mode": "local",
      "autoPush": false
    }
  },
  "confirmationProvider": {
    "channels": [
      "freedesktop"
    ]
  },
  "limits": {
    "maxConcurrentTasks": 2,
    "maxActiveProcesses": "auto",
    "processResponseBytes": 8192
  },
  "shell": {
    "initFile": "/home/your-user/.agentic_gpt/.bashrc"
  },
  "mcpServers": {
    "example-http": {
      "enabled": false,
      "transport": "streamable-http",
      "url": "https://mcp.example.com/mcp",
      "auth": {
        "type": "bearer",
        "token": "replace-me"
      }
    },
    "example-stdio": {
      "enabled": false,
      "transport": "stdio",
      "url": "node /home/your-user/mcp/server.mjs"
    }
  },
  "policy": {
    "enabled": true,
    "bubblewrap": false,
    "command": {
      "defaultAction": "confirm",
      "allow": [],
      "confirm": [
        "sudo **",
        "rm **",
        "mv **",
        "chmod **",
        "chown **",
        "mount **",
        "systemctl **",
        "service **",
        "docker **",
        "scp **",
        "curl **",
        "wget **",
        "bash **",
        "sh **",
        "zsh **",
        "fish **",
        "perl **",
        "ruby **",
        "python -c **",
        "node -e **"
      ],
      "deny": [
        "su **",
        "mkfs **",
        "dd **",
        "ssh **"
      ]
    },
    "path": {
      "defaultAction": "deny",
      "readOnly": [
        "~/.cache",
        "~/.local/share",
        "/etc/os-release",
        "/proc/meminfo",
        "/proc/cpuinfo",
        "/proc/loadavg",
        "/proc/uptime",
        "/sys/class/power_supply",
        "/sys/class/thermal"
      ],
      "write": [
        "/home/your-user/.agentic_gpt/workspace",
        "~/Documents",
        "~/Downloads",
        "~/Projects",
        "/tmp"
      ],
      "deny": [
        "~/.ssh",
        "~/.gnupg",
        "~/.local/share/keyrings",
        "~/.password-store",
        "~/.mozilla",
        "~/.config/google-chrome",
        "~/.config/chromium",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials",
        "~/.docker/config.json",
        "~/.kube",
        "~/.aws",
        "~/.config/gcloud",
        "~/.config/gh"
      ]
    }
  }
}
