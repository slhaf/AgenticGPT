[
  {
    "id": "search_context_overshoot",
    "tool": "file.search",
    "kind": "positive",
    "arguments": {
      "path": "contract-fixture.txt",
      "query": "needle",
      "contextLines": 8
    },
    "expect": {
      "resultFields": ["requestedContextLines", "effectiveContextLines", "contextLinesClipped"],
      "requestedContextLines": 8,
      "effectiveContextLines": 5,
      "contextLinesClipped": true
    }
  },
  {
    "id": "read_batch_order_and_partial_failure",
    "tool": "file.read",
    "kind": "positive",
    "arguments": {
      "requests": [
        {"path": "contract-fixture.txt", "includeContent": false},
        {"path": "missing-contract-fixture.txt"},
        {"path": "contract-fixture.txt", "startLine": 2, "endLine": 2}
      ]
    },
    "expect": {
      "status": "completed_with_errors",
      "operationCount": 3,
      "noRevision": true
    }
  },
  {
    "id": "search_batch_order_and_partial_failure",
    "tool": "file.search",
    "kind": "positive",
    "arguments": {
      "requests": [
        {"path": "contract-fixture.txt", "query": "needle"},
        {"path": "missing-contract-fixture.txt", "query": "needle"},
        {"path": "contract-fixture.txt", "query": "prefix"}
      ]
    },
    "expect": {
      "status": "completed_with_errors",
      "operationCount": 3
    }
  },
  {
    "id": "file_edit_apply_patch_dry_run",
    "tool": "file.edit",
    "kind": "positive",
    "arguments": {
      "patch": "*** Begin Patch\n*** Update File: contract-fixture.txt\n@@\n-prefix\n+changed\n*** Add File: contract-created.txt\n+created\n*** End Patch",
      "dryRun": true
    },
    "expect": {
      "status": "dry-run"
    }
  },
  {
    "id": "file_edit_descriptor",
    "tool": "file.edit",
    "kind": "descriptor",
    "arguments": {},
    "expect": {
      "descriptionIncludes": ["Codex apply_patch", "dryRun"],
      "required": ["patch"]
    }
  },
  {
    "id": "file_edit_rejects_obsolete_fields",
    "tool": "file.edit",
    "kind": "negative",
    "arguments": {
      "mode": "replace",
      "path": "contract-fixture.txt",
      "oldText": "needle",
      "newText": "invalid"
    },
    "expect": {
      "errorIncludes": "unknown tool argument"
    }
  },
  {
    "id": "file_read_mutually_exclusive",
    "tool": "file.read",
    "kind": "negative",
    "arguments": {
      "path": "contract-fixture.txt",
      "requests": [{"path": "contract-fixture.txt"}]
    },
    "expect": {
      "errorIncludes": "mutually exclusive"
    }
  },
  {
    "id": "file_search_negative_context",
    "tool": "file.search",
    "kind": "negative",
    "arguments": {
      "path": "contract-fixture.txt",
      "query": "needle",
      "contextLines": -1
    },
    "expect": {
      "errorIncludes": "invalid value"
    }
  },
  {
    "id": "mcp_batch_admission_descriptor",
    "tool": "mcp.batch",
    "kind": "descriptor",
    "arguments": {
      "calls": [
        {"id": "call-1", "serverId": "configured-server", "toolName": "tool", "arguments": {}}
      ]
    },
    "expect": {
      "descriptionIncludes": ["1..16", "not rolled back"],
      "required": ["calls"]
    }
  },
  {
    "id": "mcp_batch_missing_server",
    "tool": "mcp.batch",
    "kind": "negative",
    "arguments": {
      "calls": [
        {"id": "call-1", "serverId": "missing-server", "toolName": "one", "arguments": {}}
      ]
    },
    "expect": {
      "errorCode": "mcp_server_not_found",
      "errorIncludes": "mcp_server_not_found"
    }
  }
]
